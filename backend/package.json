{
  "name": "medora-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typeorm": "tsx ./node_modules/typeorm/cli.js",
    "migration:generate": "tsx src/database/generate-migration.ts",
    "migration:run": "tsx ./node_modules/typeorm/cli.js migration:run -d src/config/data-source.cli.ts",
    "migration:run:prod": "node ./node_modules/typeorm/cli.js migration:run -d dist/config/data-source.cli.js",
    "migration:revert": "tsx ./node_modules/typeorm/cli.js migration:revert -d src/config/data-source.cli.ts",
    "migration:show": "tsx ./node_modules/typeorm/cli.js migration:show -d src/config/data-source.cli.ts",
    "db:ensure": "tsx src/database/ensure-db.ts",
    "db:seed": "tsx src/database/seed.ts",
    "db:seed:prod": "node dist/database/seed.js",
    "db:setup": "npm run db:ensure && npm run migration:run && npm run db:seed",
    "db:backup": "tsx src/database/backup.ts",
    "db:backup:prod": "node dist/database/backup.js",
    "db:restore": "tsx src/database/restore.ts",
    "db:restore:prod": "node dist/database/restore.js",
    "db:backup-check": "npm run build && tsx src/database/backup-restore-check.ts",
    "smoke": "tsx src/smoke.ts",
    "browser:smoke": "tsx src/browser-smoke.ts",
    "browser:smoke:ci": "tsx src/browser-smoke-ci.ts",
    "test:integration": "tsx src/integration-check.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.12.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.28",
    "ws": "^8.18.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
